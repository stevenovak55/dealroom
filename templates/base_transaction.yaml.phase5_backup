    applies_if: transaction.financing_type == 'cash'
    depends_on: []
- condition: property.tenant_occupied
  tasks:
  - id: obtain_tenant_estoppels
    title: Provide tenant estoppel certificates
    category: property_specific
    owner_role: seller
    description: Obtain statements from all tenants
    due: PS
    due_offset: +10d
    applies_if: property.tenant_occupied
    depends_on: []
    documents:
    - Estoppel certificates
  - id: transfer_security_deposits
    title: Transfer security deposits
    category: property_specific
    owner_role: seller
    description: Transfer tenant deposits to buyer
    due: Closing
    due_offset: 0d
    applies_if: property.tenant_occupied
    depends_on: []
  - id: provide_tenant_leases
    title: Provide copies of all leases
    category: property_specific
    owner_role: seller
    description: Give buyer all current lease agreements
    due: PS
    due_offset: +5d
    applies_if: property.tenant_occupied
    depends_on: []
    documents:
    - Lease agreements
    - Rent roll
  - id: notify_tenants_transfer
    title: Notify tenants of ownership change
    category: property_specific
    owner_role: seller
    description: Inform tenants of new owner
    due: Closing
    due_offset: +3d
    applies_if: property.tenant_occupied
    depends_on: []
