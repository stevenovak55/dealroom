template_id: base_transaction
version: 1.0.0
title: Base Transaction Template
name: Base Transaction Template
type: universal
description: Comprehensive base template with 100+ tasks for all transaction types
created_date: '2025-10-30'
author: MA Deal Room Team
property_types:
- SFH
- Condo
- Multifamily
- Commercial
- Land
workflows:
- name: Deal Setup
  description: Initial transaction setup and document collection
  tasks:
  - id: property_info_mls
    title: Property Information Entered into MLS
    category: deal_setup
    owner_role: agent
    description: Add property details including description, pictures, and amenities
    due: Listing
    due_offset: 0d
    milestone: true
    mandatory: true
    depends_on: []
    documents:
    - Property details sheet
    - MLS listing draft
    priority: normal
    estimated_duration: MLS entry typically 1-2 hours; photos/description prep may take 1-2 days
  - id: collect_property_docs
    title: Collect property documents from seller
    category: deal_setup
    owner_role: agent
    description: Gather all property-related documents from seller
    due: Listing
    due_offset: +1d
    depends_on: []
    documents:
    - Deed
    - Prior title insurance
    - Property survey
    - Floor plans
    priority: normal
    estimated_duration: Gather documents 3-5 business days
  - id: schedule_photography
    title: Schedule professional photography
    category: deal_setup
    owner_role: agent
    description: Book photographer for listing photos and virtual tour
    due: Listing
    due_offset: +2d
    depends_on: []
    reminders:
    - offset: -1d
      channels:
      - email
      message: Photographer coming tomorrow
    priority: normal
    estimated_duration: Schedule 1-2 weeks ahead; shoot takes 1-2 hours
    vendor_type: real_estate_photographer
  - id: create_virtual_tour
    title: Create virtual tour/walkthrough
    category: deal_setup
    owner_role: agent
    description: Coordinate virtual tour creation for online listing
    due: Listing
    due_offset: +3d
    depends_on:
    - schedule_photography
    documents:
    - Virtual tour link
    priority: normal
  - id: order_prelim_title_search
    title: Order preliminary title search
    category: title_work
    owner_role: agent
    description: Request preliminary title search to identify any issues early
    due: Listing
    due_offset: +2d
    milestone: true
    depends_on: []
    priority: high
    estimated_duration: Preliminary title search typically takes 2-3 weeks
    citations:
    - url: https://www.mass.gov/info-details/real-estate-title-insurance
      title: Massachusetts Real Estate Title Requirements
  - id: sign_listing_agreement
    title: Review and sign listing agreement
    category: deal_setup
    owner_role: seller
    description: Review terms and sign formal listing agreement
    due: Listing
    due_offset: 0d
    mandatory: true
    depends_on: []
    documents:
    - Signed listing agreement
    priority: normal
  - id: gather_seller_financials
    title: Gather seller financial documents
    category: deal_setup
    owner_role: agent
    description: Collect tax bills, utility statements, HOA documents
    due: Listing
    due_offset: +2d
    depends_on: []
    documents:
    - Property tax statements
    - Utility bills
    - HOA statements
    priority: normal
  - id: agency_disclosure
    title: Provide Agency Disclosure Form
    category: compliance
    description: Present Massachusetts Mandatory Licensee-Consumer Relationship Disclosure before entering into contract with seller
    mandatory: true
    applies_if: property.state == 'MA'
    due: FirstMeeting
    due_offset: 0d
    owner_role: agent
    depends_on: []
    reminders:
    - offset: -7d
      channels:
      - email
    - offset: -1d
      channels:
      - email
    citations:
    - url: https://www.mass.gov/doc/real-estate-board-agency-disclosure-form-english/download
      title: MA Mandatory Licensee-Consumer Relationship Disclosure
    notes: Must be presented electronically or in person before entering into contract with consumer (2023 updated requirement). Not required at open houses.
    priority: critical
  - id: lead_paint_disclosure
    title: Property Transfer Lead Paint Notification
    category: compliance
    description: Provide EPA lead paint disclosure and Massachusetts Property Transfer Lead Paint Notification for homes built before 1978
    mandatory: true
    applies_if: property.year_built < 1978
    due: Offer
    due_offset: -2d
    owner_role: seller
    depends_on: []
    reminders:
    - offset: -14d
      channels:
      - email
    - offset: -7d
      channels:
      - email
    - offset: -2d
      channels:
      - email
      - sms
      priority: high
    actions:
    - type: send_form
      form_type: lead_paint_disclosure
    citations:
    - url: https://www.mass.gov/info-details/property-transfer-lead-paint-notification
      title: Property Transfer Lead Paint Notification | Mass.gov
    - url: https://www.mass.gov/doc/105-cmr-460-lead-poisoning-prevention-and-control/download
      title: 105 CMR 460.720 - Property Transfer Lead Notification
    notes: Federal EPA penalties up to $11,000 per error. Buyer has right to 10-day inspection period (can be waived). Provide EPA pamphlet 'Protect Your Family from Lead in Your Home'.
    priority: critical
- name: Party Onboarding
  description: Adding and onboarding all transaction parties
  tasks:
  - id: add_buyer_info
    title: Add buyer information to system
    category: party_onboarding
    owner_role: agent
    description: Enter buyer contact details and preferences
    due: Offer
    due_offset: +1d
    applies_if: transaction.type IN ['buy_side', 'rental_tenant']
    depends_on: []
    priority: normal
    estimated_duration: Gather buyer information 1-2 business days
  - id: add_seller_info
    title: Add seller information to system
    category: party_onboarding
    owner_role: agent
    description: Enter seller contact details
    due: Listing
    due_offset: +1d
    applies_if: transaction.type IN ['sell_side', 'rental_landlord']
    depends_on: []
    priority: normal
    estimated_duration: Gather seller information 1-2 business days
  - id: add_coop_agent
    title: Add co-operating agent information
    category: party_onboarding
    owner_role: agent
    description: Enter co-op agent and brokerage details
    due: Offer
    due_offset: +2d
    applies_if: transaction.has_coop_agent
    depends_on: []
    priority: normal
  - id: send_buyer_welcome
    title: Send welcome packet to buyer
    category: communication
    owner_role: agent
    description: Email buyer welcome packet with process overview
    due: Offer
    due_offset: +1d
    applies_if: transaction.type IN ['buy_side', 'rental_tenant']
    depends_on:
    - add_buyer_info
    documents:
    - Buyer welcome packet
    - Transaction timeline
    priority: normal
  - id: send_seller_welcome
    title: Send welcome packet to seller
    category: communication
    owner_role: agent
    description: Email seller welcome packet with process overview
    due: Listing
    due_offset: +1d
    applies_if: transaction.type IN ['sell_side', 'rental_landlord']
    depends_on:
    - add_seller_info
    documents:
    - Seller welcome packet
    - Net sheet estimate
    priority: normal
  - id: collect_preapproval
    title: Collect buyer pre-approval letter
    category: financing
    owner_role: buyer
    description: Provide mortgage pre-approval documentation
    due: Offer
    due_offset: +2d
    mandatory: true
    applies_if: transaction.needs_financing
    depends_on: []
    documents:
    - Pre-approval letter
    - Proof of funds
    priority: high
  - id: buyer_initial_consultation
    title: Schedule initial consultation with buyer
    category: party_onboarding
    owner_role: agent
    description: Meet to review timeline and next steps
    due: Offer
    due_offset: +3d
    applies_if: transaction.type IN ['buy_side', 'rental_tenant']
    depends_on: []
    priority: normal
  - id: seller_initial_consultation
    title: Schedule initial consultation with seller
    category: party_onboarding
    owner_role: agent
    description: Meet to review pricing and preparation
    due: Listing
    due_offset: +3d
    applies_if: transaction.type IN ['sell_side', 'rental_landlord']
    depends_on: []
    priority: normal
- name: Earnest Money Management
  description: Handle earnest money deposit and escrow
  tasks:
  - id: collect_emd
    title: Collect earnest money deposit
    category: earnest_money
    owner_role: agent
    description: Receive EMD check or wire from buyer
    due: Offer
    due_offset: +2d
    milestone: true
    mandatory: true
    depends_on: []
    documents:
    - EMD receipt
    - Deposit slip
    priority: high
    estimated_duration: Deposit typically due within 5 business days of offer acceptance
  - id: deposit_emd
    title: Deposit EMD into escrow account
    category: earnest_money
    owner_role: agent
    description: Deposit earnest money into designated escrow account
    due: Offer
    due_offset: +3d
    mandatory: true
    depends_on:
    - collect_emd
    priority: high
  - id: send_emd_receipt
    title: Send EMD receipt to all parties
    category: earnest_money
    owner_role: agent
    description: Provide confirmation of EMD deposit to buyer and seller
    due: Offer
    due_offset: +3d
    depends_on:
    - deposit_emd
    documents:
    - Escrow receipt
    priority: high
  - id: emd_ledger_entry
    title: Create escrow account ledger entry
    category: earnest_money
    owner_role: agent
    description: Record EMD in transaction accounting system
    due: Offer
    due_offset: +3d
    depends_on:
    - deposit_emd
    priority: high
- name: Inspection Period
  description: Property inspection and negotiation phase
  tasks:
  - id: schedule_home_inspection
    title: Schedule home inspection
    category: inspection
    owner_role: buyer
    description: Book professional home inspector
    due: PS
    due_offset: +5d
    milestone: true
    depends_on: []
    reminders:
    - offset: -2d
      channels:
      - email
      message: Inspection coming up
    priority: normal
  - id: attend_inspection
    title: Attend home inspection
    category: inspection
    owner_role: agent
    description: Be present during inspection to address questions
    due: PS
    due_offset: +7d
    depends_on:
    - schedule_home_inspection
    priority: normal
  - id: review_inspection_report
    title: Review inspection report
    category: inspection
    owner_role: buyer
    description: Review findings and determine repair requests
    due: PS
    due_offset: +9d
    depends_on:
    - attend_inspection
    documents:
    - Inspection report
    priority: normal
  - id: submit_repair_request
    title: Submit repair request or waiver
    category: inspection
    owner_role: agent
    description: Present repair requests to seller or waive contingency
    due: PS
    due_offset: +11d
    milestone: true
    depends_on:
    - review_inspection_report
    documents:
    - Repair request form
    - Inspection contingency waiver
    priority: normal
  - id: negotiate_inspection_items
    title: Negotiate inspection items
    category: inspection
    owner_role: agent
    description: Negotiate repairs, credits, or price adjustments
    due: PS
    due_offset: +14d
    depends_on:
    - submit_repair_request
    priority: normal
  - id: finalize_inspection_agreement
    title: Finalize inspection agreement
    category: inspection
    owner_role: agent
    description: Document agreed-upon inspection resolutions
    due: PS
    due_offset: +15d
    depends_on:
    - negotiate_inspection_items
    documents:
    - Signed inspection agreement
    priority: normal
  - id: schedule_specialized_inspections
    title: Schedule specialized inspections
    category: inspection
    owner_role: buyer
    description: Book additional inspections (pest, radon, etc.) if needed
    due: PS
    due_offset: +5d
    applies_if: property.needs_special_inspection
    depends_on: []
    priority: normal
  - id: coordinate_repair_work
    title: Coordinate repair work
    category: inspection
    owner_role: seller
    description: Schedule and complete agreed-upon repairs
    due: PS
    due_offset: +25d
    applies_if: inspection.repairs_needed
    depends_on:
    - finalize_inspection_agreement
    priority: normal
  - id: schedule_reinspection
    title: Schedule re-inspection
    category: inspection
    owner_role: buyer
    description: Verify completion of agreed repairs
    due: PS
    due_offset: +28d
    applies_if: inspection.reinspection_needed
    depends_on:
    - coordinate_repair_work
    priority: normal
  - id: home_inspection_schedule
    title: Coordinate Home Inspection Access
    category: inspection
    description: Work with buyer's agent to schedule home inspection and provide property access
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +7d
    owner_role: agent
    depends_on: []
    reminders:
    - offset: +2d
      channels:
      - email
    - offset: +5d
      channels:
      - email
    - offset: +7d
      channels:
      - email
    notes: Inspection contingency typically 7-15 days from P&S. Ensure utilities are on and property is accessible. Inspector will review Title 5 report.
    priority: normal
    estimated_duration: Schedule 1-2 weeks ahead; inspection takes 2-4 hours
    vendor_type: home_inspector
  - id: home_inspection_response
    title: Respond to Inspection Report Requests
    category: inspection
    description: Review buyer's inspection report and negotiate response (repairs, credits, or price adjustment)
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +12d
    owner_role: seller
    depends_on:
    - home_inspection_schedule
    reminders:
    - offset: +10d
      channels:
      - email
    - offset: +12d
      channels:
      - email
      - sms
    notes: 'Response typically due within a few days of receiving report. Options: make repairs, offer credit, reduce price, or decline (buyer may have right to terminate). Septic issues may be raised even if Title 5 passed.'
    priority: high
    estimated_duration: Response typically due 3-5 days after receiving report
- name: Purchase and Sale Agreement
  description: Negotiate and execute P&S agreement
  tasks:
  - id: draft_ps_agreement
    title: Draft purchase and sale agreement
    category: ps_agreement
    owner_role: agent
    description: Prepare comprehensive P&S with all terms
    due: Offer
    due_offset: +2d
    milestone: true
    depends_on: []
    documents:
    - P&S draft
    priority: high
  - id: attorney_review_ps
    title: Attorney review of P&S
    category: ps_agreement
    owner_role: buyer_attorney
    description: Legal review of purchase agreement terms
    due: Offer
    due_offset: +5d
    depends_on:
    - draft_ps_agreement
    priority: high
  - id: negotiate_ps_terms
    title: Negotiate P&S terms
    category: ps_agreement
    owner_role: agent
    description: Work through any requested changes
    due: Offer
    due_offset: +7d
    depends_on:
    - attorney_review_ps
    priority: high
  - id: execute_ps_agreement
    title: Execute purchase and sale agreement
    category: ps_agreement
    owner_role: buyer
    description: Sign finalized P&S agreement
    due: Offer
    due_offset: +8d
    milestone: true
    mandatory: true
    depends_on:
    - negotiate_ps_terms
    documents:
    - Signed P&S agreement
    priority: high
  - id: seller_signs_ps
    title: Seller signs P&S agreement
    category: ps_agreement
    owner_role: seller
    description: Seller executes P&S agreement
    due: Offer
    due_offset: +9d
    mandatory: true
    depends_on:
    - execute_ps_agreement
    priority: high
  - id: distribute_executed_ps
    title: Distribute fully executed P&S
    category: ps_agreement
    owner_role: agent
    description: Send signed P&S to all parties
    due: PS
    due_offset: 0d
    depends_on:
    - seller_signs_ps
    priority: high
  - id: update_transaction_timeline
    title: Update transaction timeline
    category: ps_agreement
    owner_role: agent
    description: Adjust schedule based on P&S dates
    due: PS
    due_offset: +1d
    depends_on:
    - distribute_executed_ps
    priority: high
- name: Financing
  description: Mortgage application and approval process
  tasks:
  - id: submit_mortgage_app
    title: Submit formal mortgage application
    category: financing
    owner_role: buyer
    description: Complete full mortgage application with lender
    due: PS
    due_offset: +3d
    milestone: true
    applies_if: transaction.needs_financing
    depends_on: []
    documents:
    - Loan application
    - Financial statements
    priority: high
  - id: order_appraisal
    title: Order property appraisal
    category: financing
    owner_role: buyer
    description: Lender orders property appraisal
    due: PS
    due_offset: +8d
    milestone: true
    applies_if: transaction.needs_financing
    depends_on:
    - submit_mortgage_app
    priority: high
  - id: schedule_appraisal
    title: Schedule appraisal inspection
    category: financing
    owner_role: agent
    description: Coordinate appraiser access to property
    due: PS
    due_offset: +13d
    applies_if: transaction.needs_financing
    depends_on:
    - order_appraisal
    priority: high
  - id: review_appraisal
    title: Review appraisal report
    category: financing
    owner_role: agent
    description: Review appraisal value and comparables
    due: PS
    due_offset: +15d
    applies_if: transaction.needs_financing
    depends_on:
    - schedule_appraisal
    documents:
    - Appraisal report
    priority: high
  - id: address_appraisal_issues
    title: Address appraisal issues
    category: financing
    owner_role: agent
    description: Handle any appraisal value shortfall
    due: PS
    due_offset: +18d
    applies_if: appraisal.value_issue
    depends_on:
    - review_appraisal
    priority: high
  - id: provide_additional_docs
    title: Provide additional documentation to lender
    category: financing
    owner_role: buyer
    description: Submit any additional requested documents
    due: PS
    due_offset: +10d
    applies_if: loan.needs_more_docs
    depends_on:
    - submit_mortgage_app
    priority: high
  - id: obtain_mortgage_commitment
    title: Obtain mortgage commitment
    category: financing
    owner_role: buyer
    description: Receive formal loan commitment from lender
    due: PS
    due_offset: +30d
    milestone: true
    mandatory: true
    applies_if: transaction.needs_financing
    depends_on:
    - submit_mortgage_app
    documents:
    - Commitment letter
    priority: high
  - id: review_loan_terms
    title: Review loan terms and conditions
    category: financing
    owner_role: buyer
    description: Review final loan terms with lender
    due: PS
    due_offset: +32d
    applies_if: transaction.needs_financing
    depends_on:
    - obtain_mortgage_commitment
    priority: high
  - id: clear_loan_conditions
    title: Clear loan conditions
    category: financing
    owner_role: buyer
    description: Satisfy any remaining loan conditions
    due: Closing
    due_offset: -10d
    applies_if: loan.has_conditions
    depends_on:
    - obtain_mortgage_commitment
    priority: high
  - id: schedule_loan_closing
    title: Schedule loan closing with lender
    category: financing
    owner_role: buyer
    description: Coordinate closing date with lender
    due: Closing
    due_offset: -5d
    applies_if: transaction.needs_financing
    depends_on:
    - clear_loan_conditions
    priority: high
  - id: loan_commitment_track
    title: Monitor Buyer Loan Commitment Status
    category: financing
    description: Check with buyer's agent regarding loan application progress and commitment timeline
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +21d
    owner_role: agent
    depends_on: []
    reminders:
    - offset: +14d
      channels:
      - email
    - offset: +21d
      channels:
      - email
    - offset: +28d
      channels:
      - email
      - sms
      priority: high
    notes: Typical loan commitment arrives 3-4 weeks after P&S. Mortgage contingency usually 30-45 days from P&S. If delayed, buyer may request extension (must be in writing).
    priority: high
    estimated_duration: Typical loan commitment arrives 3-4 weeks after P&S signing
  - id: loan_commitment_deadline
    title: Confirm Loan Commitment Received or Extension Granted
    category: financing
    description: Verify buyer's lender has issued commitment letter or buyer has requested written extension
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +35d
    owner_role: agent
    depends_on:
    - loan_commitment_track
    reminders:
    - offset: -7d
      channels:
      - email
    - offset: -3d
      channels:
      - email
      - sms
    - offset: -1d
      channels:
      - email
      - sms
      priority: high
    notes: Mortgage contingency typically expires 30-45 days after P&S. Extension requests must be in writing. If commitment not received and no extension, seller may have option to terminate P&S.
    priority: high
    estimated_duration: Mortgage contingency typically expires 30-45 days after P&S
  - id: appraisal_track
    title: Monitor Property Appraisal Progress
    category: financing
    description: Confirm appraisal has been ordered and track completion status
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +7d
    owner_role: agent
    depends_on: []
    reminders:
    - offset: +7d
      channels:
      - email
    - offset: +14d
      channels:
      - email
    - offset: +21d
      channels:
      - email
    notes: Appraisal usually ordered 1-2 weeks after P&S, completed 2-3 weeks after P&S. Ensure property shows well for appraiser. Appraiser will note septic system status.
    priority: high
    estimated_duration: Appraisal usually ordered 1-2 weeks after P&S, completed 2-3 weeks after P&S
    vendor_type: appraiser
  - id: appraisal_value_check
    title: Verify Appraisal Supports Sales Price
    category: financing
    description: Confirm appraisal came in at or above sales price; address low appraisal if necessary
    mandatory: true
    applies_if: property.state == 'MA'
    due: PS
    due_offset: +21d
    owner_role: agent
    depends_on:
    - appraisal_track
    reminders:
    - offset: +21d
      channels:
      - email
    - offset: +25d
      channels:
      - email
    notes: 'Low appraisal may require: buyer bringing additional cash, seller reducing price, or renegotiation. Failed septic can affect appraisal value.'
    priority: high
    estimated_duration: Appraisal results typically available 2-3 weeks after inspection
- name: Pre-Closing Preparation
  description: Final preparations before closing
  tasks:
  - id: order_title_insurance
    title: Order title insurance
    category: title_work
    owner_role: agent
    description: Order owner's and lender's title insurance policies
    due: Closing
    due_offset: -21d
    milestone: true
    depends_on: []
    documents:
    - Title commitment
    citations:
    - url: https://www.mass.gov/info-details/real-estate-title-insurance
      title: Massachusetts Real Estate Title Insurance Requirements
    priority: high
    estimated_duration: Available at closing once title is clear
  - id: review_title_commitment
    title: Review title commitment
    category: title_work
    owner_role: buyer_attorney
    description: Review title report for issues
    due: Closing
    due_offset: -18d
    depends_on:
    - order_title_insurance
    priority: high
    estimated_duration: Review title commitment within 5 business days of receipt
    citations:
    - url: https://www.mass.gov/info-details/real-estate-title-insurance
      title: Understanding Title Commitments in Massachusetts
  - id: clear_title_issues
    title: Clear title issues
    category: title_work
    owner_role: seller_attorney
    description: Resolve any title defects or liens
    due: Closing
    due_offset: -14d
    applies_if: title.has_issues
    depends_on:
    - review_title_commitment
    priority: critical
    estimated_duration: Time varies by issue complexity; allow 2-4 weeks minimum
    citations:
    - url: https://www.mass.gov/info-details/real-estate-title-insurance
      title: Massachusetts Title Defect Resolution
  - id: order_municipal_lien
    title: Order municipal lien certificate
    category: title_work
    owner_role: agent
    description: Request certificate from municipality
    due: Closing
    due_offset: -21d
    depends_on: []
    documents:
    - Lien certificate
    priority: high
    citations:
    - url: https://malegislature.gov/Laws/GeneralLaws/PartI/TitleIX/Chapter60/Section23
      title: M.G.L. Chapter 60, Section 23 - Municipal Lien Certificates
  - id: schedule_closing_date
    title: Schedule closing date and time
    category: pre_closing
    owner_role: agent
    description: Coordinate closing with all parties
    due: Closing
    due_offset: -14d
    milestone: true
    depends_on: []
    priority: high
  - id: select_closing_attorney
    title: Select closing attorney/location
    category: pre_closing
    owner_role: buyer
    description: Choose closing attorney or title company
    due: Closing
    due_offset: -14d
    depends_on: []
    priority: high
  - id: order_homeowners_insurance
    title: Order homeowner's insurance
    category: pre_closing
    owner_role: buyer
    description: Obtain insurance policy for closing
    due: Closing
    due_offset: -10d
    mandatory: true
    depends_on: []
    documents:
    - Insurance binder
    - Paid receipt
    priority: high
  - id: coordinate_utility_transfers
    title: Coordinate utility transfers
    category: pre_closing
