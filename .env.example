# MA Deal Room - WordPress Development Environment Configuration
# Copy this file to .env and update values as needed

# WordPress Configuration
WP_PORT=8080
WP_DEBUG=true

# ==============================================
# Database Configuration
# ==============================================
DB_HOST=db
DB_NAME=ma_dealroom
DB_USER=dealroom
DB_PASSWORD=dealroom_dev_pass
DB_ROOT_PASSWORD=root_secure_pass
MYSQL_PORT=3306

# ==============================================
# Redis Configuration (for caching)
# ==============================================
# Redis server hostname (use 'redis' for Docker, '127.0.0.1' for local)
REDIS_HOST=redis

# Redis server port (default: 6379)
REDIS_PORT=6379

# Redis is used for:
# - Template caching (parsed YAML, generated task lists)
# - Database query result caching
# - API response caching
# - Session storage (optional)
#
# If Redis is unavailable, the system automatically falls back to WordPress transients.
# Redis provides better performance for high-traffic applications.

# PhpMyAdmin Configuration
PMA_PORT=8081

# Plugin Configuration (for future use)
MA_DEAL_SMTP_HOST=
MA_DEAL_SMTP_PORT=
MA_DEAL_SMTP_USER=
MA_DEAL_SMTP_PASS=
MA_DEAL_SMTP_FROM_EMAIL=
MA_DEAL_SMTP_FROM_NAME=

# ==============================================
# Email Service Configuration (SendGrid)
# ==============================================
# SendGrid API Key (optional - for production email delivery)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
#
# Email Delivery Modes:
# - With SENDGRID_API_KEY set: Uses SendGrid API for email delivery
# - Without SENDGRID_API_KEY in dev (WP_ENV=development): Uses MailHog SMTP for testing
# - Without SENDGRID_API_KEY in production: Uses WordPress default wp_mail()
#
# Note: Both variable names are supported for compatibility
SENDGRID_API_KEY=
MA_DEAL_SENDGRID_API_KEY=

# Environment detection (affects email delivery mode)
# Options: development, staging, production
WP_ENV=development

# ==============================================
# SMS Service Configuration (Twilio)
# ==============================================
# Twilio Configuration (optional - for SMS notifications and reminders)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alternative environment variable names
MA_DEAL_TWILIO_SID=
MA_DEAL_TWILIO_TOKEN=
MA_DEAL_TWILIO_FROM_NUMBER=

# ==============================================
# Application Environment
# ==============================================
# Environment mode: development, staging, or production
ENVIRONMENT=development
MA_DEAL_ENV=development

# ==============================================
# JWT Authentication Configuration
# ==============================================

# ⚠️ CRITICAL SECURITY WARNING ⚠️
# YOU MUST CHANGE THESE JWT SECRETS BEFORE DEPLOYING TO PRODUCTION!
# Using default values will allow attackers to forge authentication tokens!
#
# JWT Secret Keys - MUST be strong random strings (min 64 characters each)
# Generate with: openssl rand -base64 64
# Note: These are read by AuthService for JWT token generation
#
# Example generation:
# JWT_ACCESS=$(openssl rand -base64 64)
# JWT_REFRESH=$(openssl rand -base64 64)
#
# IMPORTANT: Never commit your actual secrets to version control!

JWT_SECRET_KEY=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_64_MIN_LENGTH
JWT_REFRESH_SECRET_KEY=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_64_MIN_LENGTH

# Alternative environment variable names (also supported by AuthService)
MA_DEAL_JWT_ACCESS_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_64_MIN_LENGTH
MA_DEAL_JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_64_MIN_LENGTH

# JWT Access Token Expiration (in seconds)
# Default: 900 (15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION=900

# JWT Refresh Token Expiration (in seconds)
# Default: 604800 (7 days)
JWT_REFRESH_TOKEN_EXPIRATION=604800

# ==============================================
# Authentication & Security Configuration
# ==============================================

# Email Verification Link Expiration (in seconds)
# Default: 86400 (24 hours)
EMAIL_VERIFICATION_EXPIRATION=86400

# Password Reset Link Expiration (in seconds)
# Default: 3600 (1 hour)
PASSWORD_RESET_EXPIRATION=3600

# Account Lockout - Max Failed Login Attempts
# Default: 5
MAX_FAILED_LOGIN_ATTEMPTS=5

# Account Lockout Duration (in seconds)
# Default: 1800 (30 minutes)
ACCOUNT_LOCKOUT_DURATION=1800

# ==============================================
# Password Policy Configuration (T2.1.5)
# ==============================================

# Minimum password length (recommended: 12+)
# NIST and OWASP recommend at least 12 characters
MIN_PASSWORD_LENGTH=12

# Maximum password length
# Default: 128 characters
MAX_PASSWORD_LENGTH=128

# Password complexity requirements
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBER=true
REQUIRE_SPECIAL_CHAR=true

# Block common passwords from "Have I Been Pwned" database
# Prevents users from choosing commonly used weak passwords
BLOCK_COMMON_PASSWORDS=true

# Password history tracking
# Number of previous passwords to remember (prevents reuse)
# Default: 5
PASSWORD_HISTORY_COUNT=5

# Minimum password strength (0-4)
# 0 = any (not recommended)
# 1 = weak
# 2 = fair
# 3 = good (recommended)
# 4 = strong (very secure)
MIN_PASSWORD_STRENGTH=3

# Password expiration
# Set to 0 to disable (NIST no longer recommends forced rotation)
# If enabled, users must change password after this many days
# Default: 0 (disabled)
PASSWORD_EXPIRATION_DAYS=0

# ==============================================
# Two-Factor Authentication Configuration
# ==============================================

# 2FA Issuer Name (shown in authenticator apps)
TOTP_ISSUER="MA Deal Room"

# Number of backup codes to generate
BACKUP_CODES_COUNT=10

# ==============================================
# Rate Limiting Configuration
# ==============================================

# API Rate Limit - Max requests per minute for public endpoints
API_RATE_LIMIT_PUBLIC=60

# API Rate Limit - Max requests per minute for authenticated endpoints
API_RATE_LIMIT_AUTHENTICATED=120

# Login Rate Limit - Max login attempts per minute
LOGIN_RATE_LIMIT=5

# ==============================================
# Session & Audit Configuration
# ==============================================

# Session Cleanup - Days to keep inactive sessions
SESSION_CLEANUP_DAYS=30

# Maximum concurrent sessions per user
MAX_CONCURRENT_SESSIONS=5

# Security Event Log Retention (in days)
SECURITY_EVENT_RETENTION_DAYS=90

# Enable detailed audit logging (true/false)
ENABLE_AUDIT_LOGGING=true

# ==============================================
# User Invitation Configuration
# ==============================================

# Invitation Link Expiration (in seconds)
# Default: 604800 (7 days)
INVITATION_EXPIRATION=604800

# ==============================================
# CORS Configuration (Cross-Origin Resource Sharing)
# ==============================================
#
# CORS controls which domains can access your WordPress REST API.
# This is critical for security when your frontend is hosted separately.
#
# IMPORTANT: Update these values for your production environment!

# Frontend URL (for CORS and email links)
# Development: http://localhost:5173 (Vite) or http://localhost:3000 (React)
# Staging: https://staging.yourdomain.com
# Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173

# Allowed Origins (comma-separated list of domains that can access the API)
# Development: Include all local dev ports
# Production: Include only your production domains (NO wildcards!)
#
# Examples:
# - Development: http://localhost:5173,http://localhost:3000,http://localhost:8080
# - Production: https://app.yourdomain.com,https://www.yourdomain.com
#
# Security Notes:
# - Never use "*" (allows all origins - major security risk)
# - Always use HTTPS in production
# - Include the protocol (http:// or https://)
# - No trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Allow credentials (cookies, authorization headers) in CORS requests
# Set to "true" for authenticated API requests
# Default: true
CORS_ALLOW_CREDENTIALS=true

# CORS preflight cache duration (in seconds)
# How long the browser can cache CORS preflight responses
# Default: 86400 (24 hours)
CORS_MAX_AGE=86400

# ==============================================
# File Upload Configuration
# ==============================================

# Maximum file upload size (in bytes)
# Default: 10MB (10485760 bytes)
# For reference: 5MB = 5242880, 50MB = 52428800
MAX_FILE_SIZE=10485760

# Maximum total upload size per transaction (in bytes)
# Default: 100MB (104857600 bytes)
MAX_TOTAL_UPLOAD=104857600

# Allowed file types (comma-separated - legacy, now handled by FileSecurityService)
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# ==============================================
# File Upload Security (Virus Scanning)
# ==============================================

# Enable virus scanning for uploaded files
# If enabled, files will be scanned for viruses before storage
# Default: true (recommended for production)
ENABLE_VIRUS_SCANNING=true

# ClamAV scanner path (if installed)
# ClamAV is an open-source antivirus engine
# Install: apt-get install clamav (Ubuntu/Debian) or brew install clamav (macOS)
# Leave empty or set to /usr/bin/clamscan if installed
CLAMAV_PATH=/usr/bin/clamscan

# VirusTotal API Key (optional, alternative to ClamAV)
# Get free API key from: https://www.virustotal.com/gui/join-us
# Used as fallback if ClamAV is not available
# Note: Free tier has rate limits (4 requests/minute)
VIRUSTOTAL_API_KEY=

# Virus Scanning Behavior:
# - If ENABLE_VIRUS_SCANNING=true and ClamAV is available: Uses ClamAV
# - If ENABLE_VIRUS_SCANNING=true and VirusTotal API key is set: Uses VirusTotal
# - If ENABLE_VIRUS_SCANNING=true but no scanner available: Logs warning, allows upload
# - If ENABLE_VIRUS_SCANNING=false: Skips all virus scanning (not recommended for production)

# ==============================================
# Monitoring & Error Tracking (Sentry)
# ==============================================

# Sentry DSN for error tracking and performance monitoring
# Get your DSN from: https://sentry.io/settings/projects/
# Leave empty to disable error tracking (recommended for development)
SENTRY_DSN=
MA_DEAL_SENTRY_DSN=

# Frontend Sentry DSN (for React application)
# Usually the same as backend DSN, but can be separate if needed
VITE_SENTRY_DSN=

# Application version (for release tracking)
VITE_APP_VERSION=1.0.0
